{
  "name": "echocast",
  "version": "1.0.0",
  "private": true,
  "description": "EchoCast – Multi-Device Synchronized Audio Streaming",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev --workspace=@echocast/server\" \"npm run dev --workspace=@echocast/client\"",
    "dev:server": "npm run dev --workspace=@echocast/server",
    "dev:client": "npm run dev --workspace=@echocast/client",
    "build": "npm run build --workspace=@echocast/client && npm run build --workspace=@echocast/server",
    "start": "tsx server/src/index.ts",
    "typecheck": "npm run build --workspace=@echocast/server -- --noEmit && tsc -p client/tsconfig.json --noEmit",
    "test": "node server/test-comprehensive-reliability.mjs",
    "test:sync": "node server/test-sync-engine.mjs",
    "test:streaming": "node server/test-streaming-engine.mjs",
    "test:devices": "node server/test-device-management.mjs",
    "test:safari": "node server/test-ios-safari-stability.mjs",
    "test:radio": "node server/test-radio-sync.mjs",
    "test:all": "npm test && npm run test:sync && npm run test:streaming && npm run test:devices && npm run test:safari && npm run test:radio"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
