{
  "name": "echocast-desktop",
  "version": "1.0.0",
  "description": "EchoCast Desktop Runner & Packager for Windows and macOS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis",
    "build:mac": "electron-builder --mac dmg",
    "build:linux": "electron-builder --linux AppImage"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.echocast.desktop",
    "productName": "EchoCast",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis",
      "icon": "../client/public/icon.svg"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music",
      "icon": "../client/public/icon.svg",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    }
  }
}
